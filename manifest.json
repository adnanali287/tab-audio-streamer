{
  "manifest_version": 3,
  "name": "Tab Audio Streamer",
  "version": "1.0",
  "description": "Stream tab audio to your iPhone over WebSocket",
  "permissions": ["tabCapture", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": ["<all_urls>"]
}
